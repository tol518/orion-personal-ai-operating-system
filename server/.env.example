GATEWAY_URL=ws://127.0.0.1:18789/
GATEWAY_TOKEN=
PORT=4820
HOST=127.0.0.1

# Required for every dashboard/API session. Use a long, randomly generated
# value in server/.env; the public example intentionally contains no secret.
JARVIS_ACCESS_PASSWORD=YOUR_STRONG_LOCAL_PASSWORD
# Required to unlock the private Second Brain workspace. Keep the real value in .env only.
MEMORY_ACCESS_PASSWORD=YOUR_SEPARATE_MEMORY_PASSWORD
# Comma-separated exact browser origins. Loopback production and Vite origins
# are included automatically; add origins only behind trusted access control.
JARVIS_ALLOWED_ORIGINS=

# Jarvis talks to the vault through an Obsidian MCP server. Keep the vault path
# and any MCP credentials server-side; never expose them to the Vite client.
OBSIDIAN_VAULT=/absolute/path/to/Obsidian Vault
OBSIDIAN_MCP_COMMAND=node
OBSIDIAN_MCP_ARGS_JSON=["/absolute/path/to/obsidian-mcp.mjs"]
OBSIDIAN_MEMORY_FOLDER=Memory
OBSIDIAN_SYNC_INTERVAL_MS=2000

# Provider-specific targets stay outside the public source tree. Point the
# generic ProviderB adapter at an authorized endpoint in your private .env.
JARVIS_PROVIDER_B_BASE_URL=https://provider-b.example/
JARVIS_PROVIDER_B_GRAPHQL_PATH=/graphql
JARVIS_PROVIDER_B_BROWSER_PROFILE=

# Windows desktop bridge. Set the approved WSL node ID to carry one-shot
# PowerShell snapshots through the existing OpenClaw connection. URL/token are
# optional and only needed for the direct private-network helper mode.
WINDOWS_SCREEN_BRIDGE_URL=
WINDOWS_SCREEN_BRIDGE_TOKEN=
WINDOWS_SCREEN_BRIDGE_NODE_ID=
# Required to unlock the private Hunting workspace. Keep the real value in .env only.
HUNTING_ACCESS_PASSWORD=YOUR_SEPARATE_HUNTING_PASSWORD

# Where Hunting stages the tailored CV a browser has to attach. The default is the
# OpenClaw browser plugin's managed inbound media directory (~/.openclaw/media/inbound),
# which is the only location a containerised browser can also read: the BFF hands the
# browser a `media://inbound/<name>` reference and the browser resolves it on its own
# filesystem. Only override this when the browser shares this filesystem AND the path
# stays inside a managed upload root, otherwise every upload fails with
# "must stay within inbound media directory".
JARVIS_APPLICATION_UPLOAD_DIR=
# Non-default OpenClaw browser profile for applications (blank uses the gateway default).
JARVIS_BROWSER_PROFILE=

# Hosts J.A.R.V.I.S. may submit for without asking (comma-separated; blank means never).
# Submitting is irreversible, so this is opt-in per employer. It only fires when the checkpoint
# already reached ready_for_review: CV verifiably attached and every required field the page
# declares answered. The submit control is clicked once and the result read back from the page;
# a rejection or an unconfirmed click hands back to you and is never retried. Prepare-only hosts
# are excluded even if listed here.
# Hosts that may auto-submit from their very first application, skipping the earned-trust ramp.
# Every other host becomes eligible automatically once one application there has finished cleanly
# (verified CV attached, no required field left blank) — see hostsWithVerifiedRun in job-hunt-store.
# "*" opts every host in immediately and skips that ramp entirely.
# Example: JARVIS_AUTO_SUBMIT_HOSTS=reed.co.uk
JARVIS_AUTO_SUBMIT_HOSTS=

# Employers whose anti-spam checks reject automated form entry (comma-separated hostnames).
# For these hosts J.A.R.V.I.S. still tailors the CV, writes the cover letter, opens the form
# and attaches the files, then hands over: you type the answers and submit in the browser
# takeover. This is the supported response to a "flagged as possible spam" rejection —
# disguising the automation to slip past the check is not, and is not implemented.
# Example: JARVIS_PREPARE_ONLY_HOSTS=jobs.ashbyhq.com
JARVIS_PREPARE_ONLY_HOSTS=

# Where generated cover letters are saved as markdown, so the letter behind an interview can
# be re-read later. Blank uses server/data/cover-letters.
JARVIS_COVER_LETTER_DIR=

# Ceilings for Hunting's model turns, in milliseconds. These browse real sites through a
# Codex-routed model, so minutes are normal: a live discovery run was still streaming at
# 288s. A turn that hits its ceiling is aborted (chat.abort), never abandoned — an
# abandoned run keeps executing and the next attempt queues behind it. Blank uses the
# defaults: discovery 900000, form opening 600000, field filling 900000.
JARVIS_DISCOVERY_TIMEOUT_MS=
JARVIS_APPLICATION_OPEN_TIMEOUT_MS=
JARVIS_APPLICATION_FILL_TIMEOUT_MS=

# ---- Workflow learning (Screenpipe) ---------------------------------------
# Screenpipe is the observation layer: it already records the screen, OCR, accessibility text,
# input events, and audio locally, and Jarvis only ever reads from it. Start it separately with
# `npx screenpipe record`; see docs/workflow-learning.md. Blank uses http://127.0.0.1:3030.
SCREENPIPE_URL=
SCREENPIPE_TIMEOUT_MS=

# Local API token for screenpipe's /search endpoint. REQUIRED — /search answers 401 without it,
# even though /health is open and the published API reference does not mention auth. It is a local
# per-install token, not a cloud credential: read it with `npx screenpipe auth token`. If reads
# start failing with "rejected the API key", re-read it and restart the BFF.
SCREENPIPE_API_KEY=

# Apps whose windows are never read into a learning session, on top of the password managers and
# authenticators that are always excluded. Matched against the app and window name.
# Example: JARVIS_WORKFLOW_EXCLUDE_APPS=Messages,Signal,Banking
JARVIS_WORKFLOW_EXCLUDE_APPS=
