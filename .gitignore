# Dependencies and generated client output
node_modules/
client/dist/
*.tsbuildinfo
coverage/

# Local configuration and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Runtime state and user-generated content
server/data/
*.sqlite
*.sqlite-*
*.db
*.db-*
*.log
*.pid
*.sock

# Editor, OS, and temporary files
.DS_Store
.idea/
.vscode/
*.swp
*.tmp
*.bak

# Public-release denylist supplied outside the repository
.public-release-denylist

# ---- Added for the private source base (see docs/architecture/data-classification.md) ----
# Runtime state directories named in the architecture plan's baseline. server/data/ is already
# ignored above; these cover the same classes of content if they appear at another root.
state/
sessions/
artifacts/
attachments/
backups/
server/state/
server/sessions/
server/artifacts/
server/attachments/
server/backups/

# Private denylist and encrypted backups must never enter Git
*.age
*.gpg
*.enc

# Native macOS client build output
apps/macos/.build/
apps/macos/build/
apps/macos/*.xcodeproj/xcuserdata/
apps/macos/*.xcworkspace/xcuserdata/
DerivedData/
*.dSYM/
*.app/

# Generated from Resources/Orion.iconset by `make icon`
apps/macos/build/Orion.icns
